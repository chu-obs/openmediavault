check process rrdcached with pidfile /run/rrdcached.pid
    # Use restart so monit actually re-creates the SysV-generated unit state.
    start program = "/bin/systemctl restart rrdcached"
    stop program = "/bin/systemctl stop rrdcached"
    mode active
{%- if email_config.enable | to_bool and not notification_config.enable | to_bool %}
    noalert {{ email_config.primaryemail }}
{%- endif %}
